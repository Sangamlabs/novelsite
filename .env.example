# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Akhyana Server & Database Configuration
PORT=3000
NODE_ENV="production"
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/akhyana_db?sslmode=require"
OWNER_EMAIL="owner@akhyana.lit"
# Bcrypt hash generated using: bcrypt.hashSync('your_secure_password', 10)
OWNER_PASSWORD_HASH="$2a$10$abcdefghijklmnopqrstuvwxyz1234567890"
SESSION_SECRET="your-32-byte-random-session-secret"
FRONTEND_ORIGIN="https://your-akhyana-site.netlify.app"

# Remote Cover Storage Configuration
# Primary: Catbox (Optional user account tracking)
CATBOX_USERHASH=""

# Fallback: Yukisbox (Documented endpoint: https://yukiapi.site/upload)
YUKISBOX_API_URL="https://yukiapi.site/upload"
# Optional Yukisbox user hash for account tracking (leave empty for anonymous upload)
YUKISBOX_USERHASH=""

# Optional One-Time Owner Password Reset Flag (set to 'true' to force-reset password on deploy)
RESET_OWNER_PASSWORD="false"

